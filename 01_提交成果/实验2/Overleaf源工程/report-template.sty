\newcommand{\startreportpage}[1]{%
  \clearpage\thispagestyle{empty}\gdef\currenttop{#1}%
  \begin{tikzpicture}[remember picture,overlay,x=1mm,y=-1mm]
    \coordinate (origin) at (current page.north west);
    \draw[line width=1.5bp] ([xshift=\frameleft mm,yshift=-#1mm]origin)
      -- ++(\framewidth,0);
  \end{tikzpicture}\null}

% The guard measures the complete cell before drawing it. It never scales or
% clips text to conceal an overflow: an oversized cell is a compilation error.
\newcommand{\templaterow}[3]{%
  \sbox{\reportcellbox}{\begin{minipage}[t]{\reportbodywidth}
    \reportfont\setlength{\parskip}{2pt}%
    \setlength{\abovedisplayskip}{5pt}\setlength{\belowdisplayskip}{5pt}%
    #3\par\end{minipage}}%
  \setlength{\reportcellheight}{\dimexpr\ht\reportcellbox+\dp\reportcellbox\relax}%
  \setlength{\reportcelllimit}{\dimexpr#2mm-3.8mm\relax}%
  \typeout{TEMPLATECELL page=\thepage\space height=\the\reportcellheight\space limit=\the\reportcelllimit}%
  \ifdim\reportcellheight>\reportcelllimit
    \PackageError{report-template}{Cell overflows on page \thepage}{Split the content into another continuation page.}
  \fi
  \begin{tikzpicture}[remember picture,overlay,x=1mm,y=-1mm]
    \coordinate (o) at ([xshift=\frameleft mm,yshift=-\currenttop mm]current page.north west);
    \draw[line width=1.5bp] (o)--++(0,#2);
    \draw[line width=1.5bp] ([xshift=\framewidth mm]o)--++(0,#2);
    \draw[line width=.75bp] ([xshift=\reportlabelwidth mm]o)--++(0,#2);
    \draw[line width=.75bp] ([yshift=-#2mm]o)--++(\framewidth,0);
    \node[inner sep=0pt,outer sep=0pt,align=center,font=\reportfont,
      text width=18.25625mm] at ([xshift=11.033125mm,yshift=-#2mm/2]o) {#1};
    \node[anchor=north west,inner sep=0pt,outer sep=0pt]
      at ([xshift=23.97125mm,yshift=-1.8mm]o) {\usebox{\reportcellbox}};
  \end{tikzpicture}%
  \pgfmathparse{\currenttop+#2}\xdef\currenttop{\pgfmathresult}}

