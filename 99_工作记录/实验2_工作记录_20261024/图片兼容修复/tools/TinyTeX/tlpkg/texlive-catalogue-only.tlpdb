shortdesc armhf-linux files of dosepsbin

name dosepsbin.i386-freebsd
shortdesc i386-freebsd files of dosepsbin

name dosepsbin.i386-linux
shortdesc i386-linux files of dosepsbin

name dosepsbin.i386-netbsd
shortdesc i386-netbsd files of dosepsbin

name dosepsbin.universal-darwin
shortdesc universal-darwin files of dosepsbin

name dosepsbin.windows
shortdesc windows files of dosepsbin

name dosepsbin.x86_64-cygwin
shortdesc x86_64-cygwin files of dosepsbin

