depend latex-fonts
depend platex.ARCH
depend ptex
depend ptex-fonts
depend tex-ini-files
depend unicode-data
depend uptex
execute AddFormat name=platex engine=euptex options="*platex.ini"           patterns=language.dat           fmttriggers=ptex-fonts,l3kernel,latex,firstaid,babel,cm,hyphen-base,knuth-lib,latex-fonts,tex-ini-files,unicode-data
